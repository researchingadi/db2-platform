# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit it.

# ── Postgres (used by docker-compose.yml) ─────────────────────────────
POSTGRES_USER=db2
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=db2

# Connection string the app and drizzle-kit use. Keep in sync with the values above.
DATABASE_URL=postgres://db2:change-me-to-a-long-random-password@localhost:5432/db2

# ── Better Auth ────────────────────────────────────────────────────────
# Long random string. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the site (no trailing slash). Dev: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# ── Registration ───────────────────────────────────────────────────────
# "approval" (default): new users are "pending" until an admin approves them.
# "open": new users are approved immediately.
REGISTRATION_MODE=approval

# Comma-separated emails that become admin (and approved) when they sign up.
ADMIN_EMAILS=

# Where new-registration notices are sent.
LAB_NOTIFY_EMAIL=

# "true" requires users to verify their email before they can log in. Default false.
EMAIL_VERIFICATION_REQUIRED=false
